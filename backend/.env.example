MONGO_URI=mongodb://localhost:27017
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=pocketcampus
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
# Google OAuth 2.0 Client ID (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
# Comma-separated frontend origins. Add your deployed HTTPS URL before release.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://pocketcampus.app
